<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: bulutga zaxira va qurilmadan-qurilmaga ko'chirish qoidalari. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="online_api_keys.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="models/" />
        <exclude domain="sharedpref" path="online_api_keys.xml" />
    </device-transfer>
</data-extraction-rules>
